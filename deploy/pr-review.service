[Unit]
Description=PR Review Go Daemon (GitHub Webhook & Sandbox Reviewer)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/pr-review-go
ExecStart=/opt/pr-review-go/pr-review-go -server
Restart=always
RestartSec=5s

# Environment configuration
Environment=PORT=3000
Environment=GITHUB_TOKEN=ghp_your_token_here
Environment=WEBHOOK_SECRET=your_webhook_secret_here
Environment=LLM_BASE_URL=https://api.openai.com/v1
Environment=LLM_MODEL=gpt-4o
Environment=LLM_API_KEY=your_api_key_here

# Resource limits (lightweight Go daemon)
MemoryMax=500M
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
